# ==============================================================================
# TokenRelay Environment Configuration Template
# Copy this file to .env and insert your API keys.
# TokenRelay also works 100% offline with zero keys using local Ollama!
# ==============================================================================

# DeepSeek API (https://platform.deepseek.com) — $0.27 / 1M tokens
DEEPSEEK_API_KEY=

# Google Gemini API (https://aistudio.google.com) — Free 1,500 requests/day
GEMINI_API_KEY=

# Optional Anthropic & OpenAI Passthrough Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local Proxy & Dashboard Ports
TOKENRELAY_PROXY_PORT=8080
TOKENRELAY_DASHBOARD_PORT=8085

# Optional Square Donation / Payment URL
SQUARE_DONATE_URL=https://square.link/u/donate-tokenrelay
